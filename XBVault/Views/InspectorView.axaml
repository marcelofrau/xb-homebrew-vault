<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XBVault.ViewModels"
             x:Class="XBVault.Views.InspectorView"
             x:DataType="vm:InspectorViewModel">

  <Grid RowDefinitions="Auto,*" Margin="32">

    <!-- Row 0: Header -->
    <StackPanel Grid.Row="0" Margin="0,14,0,16">
      <TextBlock Text="INSPECTOR" Classes="PageTitle"/>
      <TextBlock Text="Discover and inspect homebrew agents running on your Xbox"
                 Classes="Muted" FontSize="14" Margin="0,4,0,0"/>
    </StackPanel>

    <!-- Row 1: Content -->
    <Grid Grid.Row="1">

      <!-- Disconnected state -->
      <StackPanel IsVisible="{Binding ShowDisconnected}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <Image Source="avares://XBVault/Assets/Views/InspectorView/inspector-search-64.png"
               Width="64" Height="64" Stretch="Uniform"
               HorizontalAlignment="Center" Opacity="0.6"/>
        <TextBlock Text="Not connected" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
        <TextBlock Text="Connect to scan for inspector-enabled apps"
                   FontSize="13" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
        <Button Command="{Binding ConnectCommand}"
                Padding="16,8"
                FontSize="14"
                HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Image Source="avares://XBVault/Assets/Views/ConnectionWindow/connection-connect-20.png"
                   Width="20" Height="20" Stretch="Uniform"/>
            <TextBlock Text="Connect" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>

      <!-- Connected content -->
      <ScrollViewer IsVisible="{Binding ShowContent}">
        <StackPanel Spacing="16" MaxWidth="720">

          <!-- Status message banner -->
          <Border IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmpty}}"
                  Background="#1AE74C3C" BorderBrush="{StaticResource DangerBrush}"
                  BorderThickness="1" CornerRadius="6" Padding="14,10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding StatusMessage}"
                         Foreground="{StaticResource DangerBrush}"
                         FontSize="13" FontWeight="SemiBold"
                         VerticalAlignment="Center"/>
              <Button Grid.Column="1" Command="{Binding ClearStatusCommand}"
                      Background="Transparent" BorderThickness="0"
                      Padding="4" Margin="0,0,0,0">
                <TextBlock Text="✕" FontSize="14" Foreground="{StaticResource DangerBrush}"/>
              </Button>
            </Grid>
          </Border>

          <!-- Scan card -->
          <Border Classes="Card" Padding="24">
            <StackPanel Spacing="16">
              <TextBlock Text="SCAN FOR AGENTS" Classes="SectionHeader"/>
              <TextBlock Text="Scan ports 9000–9010 on the configured Xbox to discover inspector-enabled homebrew apps."
                         Classes="Muted" FontSize="13"/>
              <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                <Button Command="{Binding ScanCommand}"
                        Padding="16,8"
                        FontSize="14"
                        FontWeight="SemiBold"
                        IsEnabled="{Binding ShowScanReady}"
                        Classes="Primary">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Scan" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button IsVisible="{Binding ShowScanning}"
                        Padding="16,8"
                        IsEnabled="False"
                        Grid.Column="1"
                        FontSize="14">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Scanning..." VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </Grid>
              <TextBlock Text="{Binding ScannedHost, StringFormat='Target: {0}'}"
                         Classes="Muted" FontSize="12"
                         IsVisible="{Binding ScannedHost, Converter={StaticResource StringNotEmpty}}"/>
            </StackPanel>
          </Border>

          <!-- Sessions list placeholder -->
          <Border Classes="Card" Padding="24"
                  IsVisible="{Binding ShowEmptySessions}">
            <StackPanel Spacing="12" HorizontalAlignment="Center">
              <TextBlock Text="No agents found"
                         FontSize="15" FontWeight="SemiBold"
                         Foreground="{StaticResource TextMutedBrush}"
                         HorizontalAlignment="Center"/>
              <TextBlock Text="Click Scan to discover inspector-enabled apps on your Xbox."
                         Classes="Muted" FontSize="13"
                         HorizontalAlignment="Center"
                         TextWrapping="Wrap"
                         MaxWidth="400"/>
            </StackPanel>
          </Border>

          <!-- Sessions list (future) -->
          <Border Classes="Card" Padding="24"
                  IsVisible="{Binding ShowSessions}">
            <StackPanel Spacing="12">
              <TextBlock Text="DISCOVERED AGENTS" Classes="SectionHeader"/>
              <!-- TODO: ItemsControl bound to sessions collection -->
            </StackPanel>
          </Border>

          <!-- Log feed placeholder -->
          <Border Classes="Card" Padding="24" MinHeight="200">
            <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="No active session"
                         FontSize="15" FontWeight="SemiBold"
                         Foreground="{StaticResource TextMutedBrush}"
                         HorizontalAlignment="Center"/>
              <TextBlock Text="Select a discovered agent to view its live log stream."
                         Classes="Muted" FontSize="13"
                         HorizontalAlignment="Center"
                         TextWrapping="Wrap"
                         MaxWidth="400"/>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

    </Grid>

  </Grid>

</UserControl>
