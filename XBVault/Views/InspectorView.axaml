<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XBVault.ViewModels"
             xmlns:models="using:XBVault.Models"
             xmlns:ae="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             x:Class="XBVault.Views.InspectorView"
             x:DataType="vm:InspectorViewModel">

  <Panel x:Name="DropPanel"
         Background="Transparent"
         DragDrop.AllowDrop="True">

  <Grid Margin="32,22,32,32">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="100"/>
      <RowDefinition Height="6"/>
      <RowDefinition Height="160" MinHeight="90" MaxHeight="300"/>
    </Grid.RowDefinitions>

    <!-- Row 0: Header -->
    <StackPanel Grid.Row="0" Margin="0,14,0,16">
      <TextBlock Text="INSPECTOR" Classes="PageTitle"/>
      <TextBlock Text="Discover and inspect homebrew agents running on your Xbox"
                 Classes="Muted" FontSize="14" Margin="0,4,0,0"/>
    </StackPanel>

    <!-- Row 1: Toolbar (connected only) -->
    <Border Grid.Row="1" Padding="8,6" CornerRadius="6"
            Background="{StaticResource SurfaceAltBrush}"
            IsVisible="{Binding ShowContent}">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
        <Button x:Name="ScanBtn"
                Command="{Binding ScanCommand}"
                IsEnabled="{Binding ShowScanReady}"
                Padding="10,6"
                ToolTip.Tip="Scan ports 9000-9010 for inspector-enabled agents">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Grid>
              <Image Source="avares://XBVault/Assets/Views/InspectorView/inspector-radar-20.png"
                     IsVisible="{Binding #ScanBtn.IsEnabled}"
                     Width="20" Height="20" Stretch="Uniform"/>
              <Image Source="avares://XBVault/Assets/Views/InspectorView/inspector-radar-20-disabled.png"
                     IsVisible="{Binding #ScanBtn.IsEnabled, Converter={StaticResource BoolInverse}}"
                     Width="20" Height="20" Stretch="Uniform"/>
            </Grid>
            <TextBlock Text="Scan" FontSize="13" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="1"
                IsVisible="{Binding ShowScanning}"
                IsEnabled="False"
                Padding="10,6">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Image Source="avares://XBVault/Assets/Views/InspectorView/inspector-radar-20-disabled.png"
                   Width="20" Height="20" Stretch="Uniform"/>
            <TextBlock Text="Scanning..." FontSize="13" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <ComboBox Grid.Column="2"
                  ItemsSource="{Binding ScannedSessions}"
                  SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                  PlaceholderText="No agents"
                  MinWidth="140"
                  FontSize="13"
                  IsVisible="{Binding ShowNoSessionsFound, Converter={StaticResource BoolInverse}}"/>
        <TextBlock Grid.Column="2"
                   Text="No agents"
                   Classes="Muted" FontSize="12"
                   IsVisible="{Binding ShowNoSessionsFound}"
                   VerticalAlignment="Center"/>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
          <CheckBox IsChecked="{Binding AutoScroll}"
                    FontSize="13" Foreground="White"/>
          <TextBlock Text="Auto-scroll"
                     FontSize="13" Foreground="White"
                     VerticalAlignment="Center"/>
        </StackPanel>
        <Button x:Name="FontDecBtn"
                Grid.Column="4"
                Command="{Binding DecreaseConsoleFontSizeCommand}"
                Padding="8,4"
                ToolTip.Tip="Decrease console font size">
          <Grid>
            <Image Source="avares://XBVault/Assets/Views/LogsView/logs-font-decrease-16.png"
                   IsVisible="{Binding #FontDecBtn.IsEnabled}"
                   Width="16" Height="16" Stretch="Uniform"/>
            <Image Source="avares://XBVault/Assets/Views/LogsView/logs-font-decrease-16-disabled.png"
                   IsVisible="{Binding #FontDecBtn.IsEnabled, Converter={StaticResource BoolInverse}}"
                   Width="16" Height="16" Stretch="Uniform"/>
          </Grid>
        </Button>
        <Button x:Name="FontIncBtn"
                Grid.Column="5"
                Command="{Binding IncreaseConsoleFontSizeCommand}"
                Padding="8,4"
                ToolTip.Tip="Increase console font size">
          <Grid>
            <Image Source="avares://XBVault/Assets/Views/LogsView/logs-font-increase-16.png"
                   IsVisible="{Binding #FontIncBtn.IsEnabled}"
                   Width="16" Height="16" Stretch="Uniform"/>
            <Image Source="avares://XBVault/Assets/Views/LogsView/logs-font-increase-16-disabled.png"
                   IsVisible="{Binding #FontIncBtn.IsEnabled, Converter={StaticResource BoolInverse}}"
                   Width="16" Height="16" Stretch="Uniform"/>
          </Grid>
        </Button>
        <Button Grid.Column="6"
                Command="{Binding SetOverrideAddressCommand}"
                Padding="8,4"
                ToolTip.Tip="Override Xbox IP address">
          <Grid>
            <Image Source="avares://XBVault/Assets/Views/InspectorView/inspector-override-20.png"
                   Width="16" Height="16" Stretch="Uniform"
                   IsVisible="{Binding HasOverride, Converter={StaticResource BoolInverse}}"/>
            <StackPanel Orientation="Horizontal" Spacing="3"
                        IsVisible="{Binding HasOverride}">
              <Ellipse Width="6" Height="6" Fill="#9ACA3C"
                       VerticalAlignment="Center"/>
              <TextBlock Text="{Binding OverrideAddress}"
                         FontSize="11" Foreground="#9ACA3C"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Button>
        <Button Grid.Column="7"
                Command="{Binding ToggleFilterCommand}"
                Padding="8,4"
                ToolTip.Tip="Toggle filter panel">
          <Image Source="avares://XBVault/Assets/Views/InspectorView/inspector-search-20.png"
                 Width="16" Height="16" Stretch="Uniform"/>
        </Button>
        <Button Grid.Column="8"
                Command="{Binding ClearConsoleCommand}"
                Padding="10,6"
                ToolTip.Tip="Clear console output">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Image Source="avares://XBVault/Assets/Views/InspectorView/inspector-clear-20.png"
                   Width="16" Height="16" Stretch="Uniform"/>
            <TextBlock Text="Clear" FontSize="13" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="9"
                Command="{Binding SaveConsoleCommand}"
                Padding="10,6"
                ToolTip.Tip="Save console output to file">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Image Source="avares://XBVault/Assets/Views/InspectorView/inspector-save-20.png"
                   Width="16" Height="16" Stretch="Uniform"/>
            <TextBlock Text="Save" FontSize="13" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="10"
                Command="{Binding OpenGuideCommand}"
                Padding="10,6"
                ToolTip.Tip="Open Inspector guide documentation">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Image Source="avares://XBVault/Assets/Views/InspectorView/inspector-help-20.png"
                   Width="16" Height="16" Stretch="Uniform"/>
            <TextBlock Text="Guide" FontSize="13" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- Row 2: Console output -->
    <Grid Grid.Row="2"
          IsVisible="{Binding ShowContent}">
      <Border Background="{StaticResource SurfaceAltBrush}"
              CornerRadius="6"
              Padding="12"
              Margin="0,12,0,0">
        <Grid>
          <ae:TextEditor x:Name="ConsoleEditor"
                         IsReadOnly="True"
                         ShowLineNumbers="False"
                         WordWrap="False"
                         FontFamily="{StaticResource MonoFont}"
                         FontSize="{Binding ConsoleFontSize}"
                         Background="Transparent"
                         BorderThickness="0">
            <ae:TextEditor.ContextFlyout>
              <MenuFlyout>
                <MenuItem Header="Copy" Click="OnCopyClick"/>
                <MenuItem Header="Select All" Click="OnSelectAllClick"/>
              </MenuFlyout>
            </ae:TextEditor.ContextFlyout>
          </ae:TextEditor>
          <!-- Empty-state overlay: connected, no scan done, no entries -->
          <ScrollViewer IsVisible="{Binding ShowNoSessionsFound}"
                        HorizontalScrollBarVisibility="Hidden">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="16" MaxWidth="440" Margin="0,8">
              <Image Source="avares://XBVault/Assets/Views/InspectorView/inspector-radar-20.png"
                     Width="32" Height="32" Stretch="Uniform"
                     HorizontalAlignment="Center" Opacity="0.4"/>
              <TextBlock Text="No agents found"
                         FontSize="14" FontWeight="SemiBold"
                         Foreground="{StaticResource TextMutedBrush}"
                         HorizontalAlignment="Center"/>
              <TextBlock Text="Hit Scan to discover homebrew agents on ports 9000–9010"
                         FontSize="12"
                         Foreground="{StaticResource TextDimBrush}"
                         HorizontalAlignment="Center"
                         TextWrapping="Wrap"
                         MaxWidth="360"
                         TextAlignment="Center"/>

              <!-- Feature list -->
              <Border Background="{StaticResource SurfaceAltBrush}"
                      CornerRadius="8" Padding="14,10">
                <StackPanel Spacing="6">
                  <TextBlock Text="Real-time log streaming from your UWP app"
                             FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                  <TextBlock Text="Lua REPL — evaluate scripts and inspect state live"
                             FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                  <TextBlock Text="Bind C# / C++ variables and read them from your PC"
                             FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
              </Border>

              <!-- uwp-xray-depot card -->
              <Border Background="{StaticResource SurfaceAltBrush}"
                      CornerRadius="8" Padding="14,10">
                <StackPanel Spacing="4">
                  <TextBlock Text="uwp-xray-depot" FontSize="12" FontWeight="SemiBold"
                             Foreground="{StaticResource AccentBrush}"/>
                  <TextBlock TextWrapping="Wrap"
                             FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                    C++ library — add to your UWP project for TCP-based log streaming and a Lua 5.4 REPL.
                  </TextBlock>
                  <TextBlock Text="Visit project ▸"
                             FontSize="11" Foreground="{StaticResource AccentBrush}"
                             Cursor="Hand"
                             PointerPressed="OnXrayDepotLinkClick"/>
                </StackPanel>
              </Border>

              <!-- xb-xray-py-connector card -->
              <Border Background="{StaticResource SurfaceAltBrush}"
                      CornerRadius="8" Padding="14,10">
                <StackPanel Spacing="4">
                  <TextBlock Text="xb-xray-py-connector" FontSize="12" FontWeight="SemiBold"
                             Foreground="{StaticResource AccentBrush}"/>
                  <TextBlock TextWrapping="Wrap"
                             FontSize="11" Foreground="{StaticResource TextMutedBrush}">
                    Python CLI — auto-scan ports, colorized output, zero dependencies. Connect from your terminal.
                  </TextBlock>
                  <TextBlock Text="Visit project ▸"
                             FontSize="11" Foreground="{StaticResource AccentBrush}"
                             Cursor="Hand"
                             PointerPressed="OnPyConnectorLinkClick"/>
                </StackPanel>
              </Border>

              <Button Command="{Binding OpenGuideCommand}"
                      Padding="12,6"
                      FontSize="12"
                      HorizontalAlignment="Center"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{StaticResource AccentBrush}">
                 <TextBlock Text="Read the Inspector Guide"
                            TextDecorations="Underline"
                            VerticalAlignment="Center"/>
              </Button>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Filter overlay — sibling of Border, flush to top-right -->
      <Border IsVisible="{Binding IsFilterVisible}"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              Background="{StaticResource SurfaceBrush}"
              BorderThickness="0"
              CornerRadius="0,0,0,6"
              Padding="10,8"
              Margin="0,12,0,0"
              MinWidth="200">
        <StackPanel Spacing="5">
            <TextBox Text="{Binding FilterText}"
                     PlaceholderText="Filter..."
                     FontSize="13"
                     Background="{StaticResource SurfaceAltBrush}"
                     KeyDown="OnFilterKeyDown"/>
             <TextBlock Text="{Binding FilterMatchText}"
                         FontSize="11"
                         Foreground="{StaticResource WarningBrush}"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Row 3: GridSplitter (invisible) -->
    <GridSplitter Grid.Row="3"
                  Height="6"
                  HorizontalAlignment="Stretch"
                  Background="Transparent"
                  IsVisible="{Binding ShowContent}"
                  ResizeBehavior="PreviousAndNext"
                  Margin="0,0,0,0"/>

    <!-- Row 4: REPL input (resizable via splitter) -->
    <Border Grid.Row="4"
            IsVisible="{Binding ShowContent}"
            Background="{StaticResource SurfaceAltBrush}"
            CornerRadius="6"
            Padding="8,6"
            Margin="0,0,0,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox x:Name="ReplInput"
                 Text="{Binding ReplInput, Mode=TwoWay}"
                 PlaceholderText="Type a command..."
                 FontFamily="{StaticResource MonoFont}"
                 FontSize="13"
                 Background="{StaticResource SurfaceBrush}"
                 BorderThickness="0"
                 CornerRadius="4"
                 Padding="8,6"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"/>
        <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="4"
                    VerticalAlignment="Bottom">
          <Button Command="{Binding ShowHelpCommand}"
                  Padding="10,6"
                  ToolTip.Tip="Show REPL help">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Image Source="avares://XBVault/Assets/Views/InspectorView/inspector-help-20.png"
                     Width="20" Height="20" Stretch="Uniform"/>
              <TextBlock Text="Help" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Command="{Binding SendCommand}"
                  Padding="10,6"
                  ToolTip.Tip="Send command (Ctrl+Enter)">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Image Source="avares://XBVault/Assets/Views/InspectorView/inspector-terminal-20.png"
                     Width="20" Height="20" Stretch="Uniform"/>
              <TextBlock Text="Send" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Disconnected state -->
    <ScrollViewer Grid.Row="1" Grid.RowSpan="4"
                  IsVisible="{Binding ShowDisconnected}"
                  HorizontalScrollBarVisibility="Hidden">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                  Spacing="20" MaxWidth="480" Margin="0,16">
        <Image Source="avares://XBVault/Assets/Views/InspectorView/inspector-search-64.png"
               Width="64" Height="64" Stretch="Uniform"
               HorizontalAlignment="Center" Opacity="0.6"/>
        <StackPanel Spacing="4">
          <TextBlock Text="XB INSPECTOR" FontSize="18" FontWeight="Bold"
                     Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/>
          <TextBlock Text="Remote diagnostics for Xbox homebrews"
                     FontSize="13" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Feature list -->
        <Border Background="{StaticResource SurfaceAltBrush}"
                CornerRadius="8" Padding="16,12">
          <StackPanel Spacing="8">
            <TextBlock Text="Real-time log streaming from your UWP app"
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Text="Lua REPL — evaluate scripts and inspect state live"
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Text="Bind C# / C++ variables and read them from your PC"
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
            <TextBlock Text="Auto-scan TCP ports 9000–9009"
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
          </StackPanel>
        </Border>

        <!-- uwp-xray-depot card -->
        <Border Background="{StaticResource SurfaceAltBrush}"
                CornerRadius="8" Padding="16,12">
          <StackPanel Spacing="6">
            <TextBlock Text="uwp-xray-depot" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}"/>
            <TextBlock TextWrapping="Wrap"
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}">
              C++ library you add to your UWP project. Opens a TCP socket and streams logs, runs a Lua 5.4 sandboxed REPL, and exposes live C# / C++ variables for remote inspection.
            </TextBlock>
            <TextBlock Text="Visit project ▸"
                       FontSize="11" Foreground="{StaticResource AccentBrush}"
                       Cursor="Hand"
                       PointerPressed="OnXrayDepotLinkClick"/>
          </StackPanel>
        </Border>

        <!-- xb-xray-py-connector card -->
        <Border Background="{StaticResource SurfaceAltBrush}"
                CornerRadius="8" Padding="16,12">
          <StackPanel Spacing="6">
            <TextBlock Text="xb-xray-py-connector" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource AccentBrush}"/>
            <TextBlock TextWrapping="Wrap"
                       FontSize="12" Foreground="{StaticResource TextMutedBrush}">
              Python CLI to connect from your terminal. Auto-scans ports, colorized log output, zero dependencies (pure stdlib). Use this if you prefer a command-line workflow.
            </TextBlock>
            <TextBlock Text="Visit project ▸"
                       FontSize="11" Foreground="{StaticResource AccentBrush}"
                       Cursor="Hand"
                       PointerPressed="OnPyConnectorLinkClick"/>
          </StackPanel>
        </Border>

        <!-- Action buttons -->
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Button Command="{Binding ConnectCommand}"
                  Padding="16,8"
                  FontSize="14">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Image Source="avares://XBVault/Assets/Views/ConnectionWindow/connection-connect-20.png"
                     Width="20" Height="20" Stretch="Uniform"/>
              <TextBlock Text="Connect" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button Command="{Binding SetOverrideAddressCommand}"
                  Padding="16,8"
                  FontSize="14"
                  ToolTip.Tip="Override Xbox IP address">
            <Grid>
              <StackPanel Orientation="Horizontal" Spacing="4"
                          IsVisible="{Binding HasOverride, Converter={StaticResource BoolInverse}}">
                <Image Source="avares://XBVault/Assets/Views/InspectorView/inspector-override-20.png"
                       Width="16" Height="16" Stretch="Uniform"/>
                <TextBlock Text="Override IP" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="4"
                          IsVisible="{Binding HasOverride}">
                <Ellipse Width="6" Height="6" Fill="#9ACA3C"
                         VerticalAlignment="Center"/>
                <TextBlock Text="{Binding OverrideAddress}"
                           FontSize="14" Foreground="#9ACA3C"
                           VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>
          </Button>
          <Button Command="{Binding OpenGuideCommand}"
                  Padding="16,8"
                  FontSize="14"
                  ToolTip.Tip="Open Inspector documentation">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Image Source="avares://XBVault/Assets/Views/InspectorView/inspector-help-20.png"
                     Width="20" Height="20" Stretch="Uniform"/>
              <TextBlock Text="Guide" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

  </Grid>

    <!-- Drop overlay (on top of all content) -->
    <Border x:Name="DropOverlay"
            IsVisible="False"
            IsHitTestVisible="False"
            ZIndex="100"
            Background="#CC1A1A2E"
            BorderThickness="2"
            BorderBrush="#B40078D7"
            CornerRadius="12"
            Margin="4">
      <StackPanel VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  Spacing="12">
        <Image Source="avares://XBVault/Assets/Icons/droppackage-64.png"
               Width="64" Height="64"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               Opacity="0.8"/>
        <TextBlock Text="Drop a package to install"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="White"
                   HorizontalAlignment="Center"/>
        <TextBlock Text=".appx  .msix  .appxbundle  .zip"
                   FontSize="12"
                   Foreground="#AAAAAA"
                   HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>
  </Panel>

</UserControl>
