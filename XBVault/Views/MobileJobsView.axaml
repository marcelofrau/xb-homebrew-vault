<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="using:XBVault.Services"
             xmlns:models="using:XBVault.Models"
             xmlns:views="using:XBVault.Views"
             x:Class="XBVault.Views.MobileJobsView"
             x:DataType="services:BackgroundTaskService"
             Background="{StaticResource BgBrush}">

  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- Title bar -->
    <views:MobileTitleBar Grid.Row="0"
                          x:Name="TitleBar"
                          Title="Background Tasks"
                          ShowBackButton="True"
                          ShowAppIcon="False"/>

    <!-- Content -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16,8">
      <StackPanel Spacing="12">

        <!-- Empty state -->
        <TextBlock IsVisible="{Binding ActiveCount, Converter={StaticResource IntToBoolInverse}}"
                   Text="No active tasks."
                   FontSize="14"
                   Foreground="{StaticResource TextMutedBrush}"
                   TextAlignment="Center"
                   Margin="0,20"/>

        <!-- Active tasks -->
        <StackPanel Spacing="6" IsVisible="{Binding ActiveCount, Converter={StaticResource IntToBool}}">
          <TextBlock Text="ACTIVE"
                     FontSize="11"
                     FontWeight="Bold"
                     Foreground="{StaticResource AccentBrush}"
                     LetterSpacing="1"
                     Margin="4,0"/>
          <ItemsControl ItemsSource="{Binding ActiveTasks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:BackgroundTask">
                <Border Padding="12,10"
                        CornerRadius="6"
                        Background="{StaticResource CardBgBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Text="{Binding Name}"
                                 FontSize="14"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource TextBrush}"
                                 VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Status}"
                                 FontSize="11"
                                 Foreground="{StaticResource TextDimBrush}"
                                 VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding StatusMessage, Converter={StaticResource StringNotEmpty}}"/>
                    <ProgressBar IsIndeterminate="{Binding IsIndeterminate}"
                                 Value="{Binding Progress}"
                                 Maximum="1.0"
                                 Height="4"
                                 Foreground="{StaticResource AccentBrush}"
                                 IsVisible="{Binding ShowProgress}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Scheduled jobs -->
        <StackPanel Spacing="6" IsVisible="{Binding ScheduledJobs.Count, Converter={StaticResource IntToBool}}">
          <TextBlock Text="SCHEDULED"
                     FontSize="11"
                     FontWeight="Bold"
                     Foreground="{StaticResource TextDimBrush}"
                     LetterSpacing="1"
                     Margin="4,0"/>
          <ItemsControl ItemsSource="{Binding ScheduledJobs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:BackgroundTask">
                <Border Padding="12,10"
                        CornerRadius="6"
                        Background="{StaticResource CardBgBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Text="{Binding Name}"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding NextRunAtLocal, StringFormat={}{0:HH:mm}}"
                                 FontSize="11"
                                 Foreground="{StaticResource TextDimBrush}"
                                 VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="{StaticResource TextDimBrush}"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Recent tasks -->
        <StackPanel Spacing="6" IsVisible="{Binding RecentTasks.Count, Converter={StaticResource IntToBool}}">
          <TextBlock Text="RECENT"
                     FontSize="11"
                     FontWeight="Bold"
                     Foreground="{StaticResource TextDimBrush}"
                     LetterSpacing="1"
                     Margin="4,0"/>
          <ItemsControl ItemsSource="{Binding RecentTasks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:BackgroundTask">
                <Border Padding="12,10"
                        CornerRadius="6"
                        Background="{StaticResource CardBgBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBlock Text="{Binding Name}"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Foreground="{StaticResource TextMutedBrush}"
                                 VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Status}"
                                 FontSize="11"
                                 Foreground="{StaticResource TextDimBrush}"
                                 VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12"
                               Foreground="{StaticResource TextDimBrush}"
                               TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Grid>

</UserControl>
