<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="using:XBVault.Services"
             xmlns:models="using:XBVault.Models"
             x:Class="XBVault.Views.NotificationsPanel"
             x:DataType="services:NotificationCenterService">

  <Border Width="340"
          MaxHeight="480"
          Background="{StaticResource SurfaceAltBrush}"
          BorderBrush="{StaticResource BorderBrush}"
          BorderThickness="1"
          CornerRadius="6"
          BoxShadow="0 4 20 0 #55000000">
    <Grid RowDefinitions="Auto,*" Margin="8">

      <!-- Header -->
      <Grid ColumnDefinitions="*,Auto,Auto" Margin="4,4,4,6">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Notifications"
                     FontSize="15"
                     FontWeight="Bold"
                     Foreground="{StaticResource TextBrush}"/>
          <Border Background="#E53935"
                  CornerRadius="8"
                  MinWidth="22"
                  Height="18"
                  Padding="4,0"
                  IsVisible="{Binding UnacknowledgedCount, Converter={StaticResource IntToBool}}">
            <TextBlock Text="{Binding UnacknowledgedCount}"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="White"
                       TextAlignment="Center"
                       VerticalAlignment="Center"/>
          </Border>
        </StackPanel>
        <Button Grid.Column="1"
                Content="Clear all"
                FontSize="12"
                Padding="6,2"
                Background="Transparent"
                Foreground="{StaticResource TextMutedBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Cursor="Hand"
                Click="OnClearAllClick"/>
        <Button Grid.Column="2"
                Content="✕"
                FontSize="13"
                Padding="6,1"
                Margin="4,0,0,0"
                Background="Transparent"
                Foreground="{StaticResource TextMutedBrush}"
                BorderThickness="0"
                CornerRadius="4"
                Cursor="Hand"
                Click="OnCloseClick"/>
      </Grid>

      <ScrollViewer Grid.Row="1">
        <StackPanel Spacing="8">

          <!-- Empty state (nothing active) -->
          <StackPanel IsVisible="{Binding Active.Count, Converter={StaticResource IntToBoolInverse}}">
            <Border Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,8">
              <TextBlock Text="No notifications yet."
                         FontSize="13"
                         Foreground="{StaticResource TextMutedBrush}"
                         TextAlignment="Center"/>
            </Border>
          </StackPanel>

          <!-- Active -->
          <StackPanel Spacing="2" IsVisible="{Binding Active.Count, Converter={StaticResource IntToBool}}">
            <TextBlock Text="ACTIVE"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"
                       LetterSpacing="1"
                       Margin="4,0"/>
            <ItemsControl ItemsSource="{Binding Active}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:NotificationItem">
                  <Border Padding="8,6"
                          CornerRadius="5"
                          Background="{StaticResource CardBgBrush}"
                          BorderBrush="{StaticResource CardBorderBrush}"
                          BorderThickness="1">
                    <Border.Styles>
                      <Style Selector="Border:pointerover">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                      </Style>
                    </Border.Styles>
                    <StackPanel Spacing="4">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CreatedAt, StringFormat={}{0:HH:mm:ss} UTC}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                Content="✕"
                                FontSize="11"
                                Padding="4,0"
                                Background="Transparent"
                                Foreground="{StaticResource TextMutedBrush}"
                                BorderThickness="0"
                                CornerRadius="3"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Click="OnDismissClick"/>
                      </Grid>
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Image Source="{Binding IconUri}"
                               Width="16" Height="16" Stretch="Uniform"
                               VerticalAlignment="Top"
                               Margin="0,2,0,0"
                               IsVisible="{Binding IconUri, Converter={StaticResource StringNotEmpty}}"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding Message}"
                                     FontSize="12"
                                     Foreground="{StaticResource TextMutedBrush}"
                                     TextWrapping="Wrap"/>
                          <ItemsControl ItemsSource="{Binding Actions}"
                                        IsVisible="{Binding IsGrouped}"
                                        Margin="0,2,0,0">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="models:NotificationAction">
                                <Button Content="{Binding Label}"
                                        FontSize="12"
                                        Padding="8,4"
                                        Margin="0,1,0,1"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        Foreground="{StaticResource AccentBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        CornerRadius="3"
                                        Cursor="Hand"
                                        Click="OnActionClick"/>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- History -->
          <StackPanel Spacing="2">
            <TextBlock Text="HISTORY"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextDimBrush}"
                       LetterSpacing="1"
                       Margin="4,0"/>
            <ItemsControl ItemsSource="{Binding History}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:NotificationItem">
                  <Border Padding="8,6"
                          CornerRadius="5"
                          Background="{StaticResource CardBgBrush}"
                          BorderBrush="{StaticResource CardBorderBrush}"
                          BorderThickness="1">
                    <Border.Styles>
                      <Style Selector="Border:pointerover">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                      </Style>
                    </Border.Styles>
                    <StackPanel Spacing="4">
                      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CreatedAt, StringFormat={}{0:HH:mm:ss} UTC}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="2"
                                Content="✕"
                                FontSize="11"
                                Padding="4,0"
                                Background="Transparent"
                                Foreground="{StaticResource TextMutedBrush}"
                                BorderThickness="0"
                                CornerRadius="3"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                Click="OnHistoryClearClick"/>
                      </Grid>
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding Message}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <ItemsControl ItemsSource="{Binding Actions}"
                                      IsVisible="{Binding IsGrouped}"
                                      Margin="0,2,0,0">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:NotificationAction">
                              <Button Content="{Binding Label}"
                                      FontSize="12"
                                      Padding="8,3"
                                      Margin="0,1,0,1"
                                      HorizontalContentAlignment="Left"
                                      Background="Transparent"
                                      Foreground="{StaticResource AccentBrush}"
                                      BorderBrush="{StaticResource BorderBrush}"
                                      CornerRadius="3"
                                      Cursor="Hand"
                                      Click="OnActionClick"/>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</UserControl>
