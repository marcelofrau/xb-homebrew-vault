<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:XBVault.Views"
             x:Class="XBVault.Views.MobileConfirmDialogView"
             x:DataType="views:MobileConfirmDialogViewModel"
             Background="#AA000000">

  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    </Style>
  </UserControl.Styles>

  <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32">
    <Border Background="{StaticResource SurfaceBrush}" CornerRadius="12"
            Padding="24,20" MaxWidth="380" HorizontalAlignment="Stretch">
      <StackPanel Spacing="16">
        <!-- Centered image -->
        <Image x:Name="DialogIcon" Width="64" Height="64"
               Stretch="Uniform" HorizontalAlignment="Center"
               IsVisible="{Binding ImageSource, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <!-- Title -->
        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold"
                   Foreground="White" TextWrapping="Wrap" HorizontalAlignment="Center"/>
        <!-- Message -->
        <TextBlock Text="{Binding Message}" FontSize="14"
                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                   HorizontalAlignment="Center" TextAlignment="Center"/>
        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
          <Button Command="{Binding CancelCommand}"
                  Padding="20,12" FontSize="14" Background="{StaticResource SurfaceAltBrush}"
                  Foreground="{StaticResource TextMutedBrush}">
            <TextBlock Text="{Binding CancelText}"/>
          </Button>
          <Button Command="{Binding ConfirmCommand}"
                  Padding="20,12" FontSize="14" FontWeight="Bold"
                  Background="{StaticResource AccentBrush}" Foreground="White">
            <TextBlock Text="{Binding ConfirmText}"/>
          </Button>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>

</UserControl>
