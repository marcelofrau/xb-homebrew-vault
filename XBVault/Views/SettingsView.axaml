<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vm="using:XBVault.ViewModels"
              x:Class="XBVault.Views.SettingsView"
               x:DataType="vm:SettingsViewModel" Cursor="{Binding Cursor}">

  <Grid RowDefinitions="Auto,*" Margin="32">

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="0,14,0,16">
      <TextBlock Text="SETTINGS"
                 Classes="PageTitle"/>
      <TextBlock Text="Connection and application preferences"
                 Classes="Muted"
                 FontSize="14"
                 Margin="0,4,0,0"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1">
      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="1*,1*" ColumnSpacing="16">
      <StackPanel Grid.Column="0" Spacing="5">

        <!-- Connection Section -->
        <Border Classes="Card" Padding="24">
          <StackPanel Spacing="12">

            <TextBlock Text="XBOX CONNECTION"
                       Classes="SectionHeader"/>

            <!-- Address / Port -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="Address"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBox PlaceholderText="192.168.1.100"
                         Text="{Binding Address}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Port"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBox PlaceholderText="11443"
                         Text="{Binding Port}"/>
                <TextBlock Text="{Binding PortError}"
                           Foreground="{StaticResource DangerBrush}"
                           FontSize="11"
                           IsVisible="{Binding PortError, Converter={StaticResource StringNotEmpty}}"/>
              </StackPanel>
            </Grid>

            <!-- HTTPS toggle -->
            <CheckBox IsChecked="{Binding UseHttps}"
                      Foreground="{StaticResource TextMutedBrush}"
                      FontSize="13">
              <TextBlock Text="Use HTTPS (recommended)"/>
            </CheckBox>

            <!-- Username / Password -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="Username"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBox PlaceholderText="Dev Mode username"
                         Text="{Binding Username}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="Password"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBox PlaceholderText="Dev Mode password"
                         Text="{Binding Password}"
                         PasswordChar="●"/>
              </StackPanel>
            </Grid>

            <Separator Background="{StaticResource BorderBrush}" Height="1" Margin="0,4"/>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
              <Button x:Name="TestConnBtn"
                      Command="{Binding TestConnectionCommand}"
                      IsEnabled="{Binding IsTestingConnection, Converter={StaticResource BoolInverse}}"
                      Padding="16,8">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                  <Grid>
                    <Image Source="avares://XBVault/Assets/Views/SettingsView/settings-test-20.png"
                           IsVisible="{Binding #TestConnBtn.IsEnabled}"
                           Width="20" Height="20" Stretch="Uniform"/>
                    <Image Source="avares://XBVault/Assets/Views/SettingsView/settings-test-20-disabled.png"
                           IsVisible="{Binding #TestConnBtn.IsEnabled, Converter={StaticResource BoolInverse}}"
                           Width="20" Height="20" Stretch="Uniform"/>
                  </Grid>
                  <TextBlock Grid.Column="1" Text="Test Connection"
                             VerticalAlignment="Center"/>
                </Grid>
              </Button>
              <Button Classes="Accent"
                      Command="{Binding SaveSettingsCommand}"
                      Padding="16,8">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                  <Image Source="avares://XBVault/Assets/Views/SettingsView/settings-save-20.png"
                         Width="20" Height="20"
                         Stretch="Uniform"/>
                  <TextBlock Grid.Column="1" Text="Save"
                             VerticalAlignment="Center"/>
                </Grid>
              </Button>
            </StackPanel>

            <!-- Saved notification -->
            <Border IsVisible="{Binding ShowSavedNotification}"
                    Background="#1A3A1E"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Path Data="M10,18 L16,24 L26,12"
                      Stroke="{StaticResource AccentBrush}"
                      StrokeThickness="2"
                      StrokeLineCap="Round"
                      StrokeJoin="Round"
                      Width="20" Height="20"
                      Stretch="Uniform"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding SavedNotificationText}"
                           Foreground="{StaticResource AccentGlowBrush}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
              </Grid>
            </Border>

          </StackPanel>
        </Border>

        <!-- Logs Section -->
        <Border Classes="Card" Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="LOGS"
                       Classes="SectionHeader"/>

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="Logs folder"
                           FontSize="13"/>
                <TextBlock Text="Open the app's log directory"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
              </StackPanel>
              <Button Grid.Column="1"
                      Command="{Binding OpenLogsFolderCommand}"
                      Padding="12,6"
                      VerticalAlignment="Center">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                  <Image Source="avares://XBVault/Assets/Views/SettingsView/settings-folder-20.png"
                         Width="20" Height="20"
                         Stretch="Uniform"/>
                  <TextBlock Grid.Column="1" Text="Open"
                             FontSize="12"
                             VerticalAlignment="Center"/>
                </Grid>
              </Button>
            </Grid>

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="Logs screen"
                           FontSize="13"/>
                <TextBlock Text="Jump to the live log console"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
              </StackPanel>
              <Button Grid.Column="1"
                      Command="{Binding GoToLogsCommand}"
                      Padding="12,6"
                      VerticalAlignment="Center">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                  <Image Source="avares://XBVault/Assets/Views/SettingsView/settings-logs-20.png"
                         Width="20" Height="20"
                         Stretch="Uniform"/>
                  <TextBlock Grid.Column="1" Text="Open"
                             FontSize="12"
                             VerticalAlignment="Center"/>
                </Grid>
              </Button>
            </Grid>
          </StackPanel>
        </Border>

      </StackPanel>

        <!-- Application Section (cache, logging, app management) -->
        <Border Classes="Card" Padding="24" Grid.Column="1" VerticalAlignment="Top">
          <StackPanel Spacing="12">
            <TextBlock Text="APPLICATION"
                       Classes="SectionHeader"/>

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="Local package cache"
                           FontSize="13"/>
                <TextBlock Text="{Binding CacheSizeText}"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
              </StackPanel>
              <Button Grid.Column="1"
                      Command="{Binding ClearCacheCommand}"
                      Padding="12,6"
                      VerticalAlignment="Center">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                  <Image Source="avares://XBVault/Assets/Views/SettingsView/settings-clear-20.png"
                         Width="20" Height="20"
                         Stretch="Uniform"/>
                  <TextBlock Grid.Column="1" Text="Clear cache"
                             FontSize="12"
                             VerticalAlignment="Center"/>
                </Grid>
              </Button>
            </Grid>

            <Separator Background="{StaticResource BorderBrush}" Height="1"/>

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="Reset window size"
                           FontSize="13"/>
                <TextBlock Text="Restore the default main window size on next start"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
              </StackPanel>
              <Button Grid.Column="1"
                      Command="{Binding ResetWindowSizeCommand}"
                      Padding="12,6"
                      VerticalAlignment="Center">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                  <Image Source="avares://XBVault/Assets/Views/SettingsView/settings-reset-20.png"
                         Width="20" Height="20"
                         Stretch="Uniform"/>
                  <TextBlock Grid.Column="1" Text="Reset size"
                             FontSize="12"
                             VerticalAlignment="Center"/>
                </Grid>
              </Button>
            </Grid>

            <Separator Background="{StaticResource BorderBrush}" Height="1"/>

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="Minimum log level"
                           FontSize="13"/>
              </StackPanel>
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding LogLevels}"
                        SelectedItem="{Binding SelectedLogLevel}"
                        Width="160"/>
            </Grid>
            <TextBlock Text="Changes take effect immediately. Restart to capture startup logs."
                       FontSize="11"
                       Foreground="{StaticResource TextDimBrush}"
                       TextWrapping="Wrap"/>

            <Separator Background="{StaticResource BorderBrush}" Height="1"/>

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="UI scale"
                           FontSize="13"/>
                <TextBlock Text="Shrinks the interface when it doesn't fit your screen"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
              </StackPanel>
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding UiScaleOptions}"
                        SelectedItem="{Binding UiScalePercent}"
                        Width="160">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding StringFormat='{}{0}%'}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <TextBlock Text="Applied immediately to open windows"
                       FontSize="11"
                       Foreground="{StaticResource TextDimBrush}"
                       TextWrapping="Wrap"/>

            <Separator Background="{StaticResource BorderBrush}" Height="1"/>

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="Connection check interval"
                           FontSize="13"/>
                <TextBlock Text="Checks the Xbox is still reachable while connected. 0 = disabled. Default: 30 s"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap"/>
              </StackPanel>
              <NumericUpDown x:Name="IntervalNud"
                             Grid.Column="1"
                             Value="{Binding ConnectionCheckIntervalSeconds}"
                             Minimum="0"
                             Maximum="3600"
                             Increment="5"
                             Width="120"
                             VerticalAlignment="Center"
                             FormatString="0 s"/>
            </Grid>

            <Separator Background="{StaticResource BorderBrush}" Height="1"/>

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="Restart application"
                           FontSize="13"/>
                <TextBlock Text="Restart to apply changes or resolve issues"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
              </StackPanel>
              <Button Grid.Column="1"
                      Command="{Binding RestartAppCommand}"
                      Padding="12,6"
                      VerticalAlignment="Center">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                  <Image Source="avares://XBVault/Assets/Views/SettingsView/settings-restart-20.png"
                         Width="20" Height="20"
                         Stretch="Uniform"/>
                  <TextBlock Grid.Column="1" Text="Restart"
                             FontSize="12"
                             VerticalAlignment="Center"/>
                </Grid>
              </Button>
            </Grid>

            <Separator Background="{StaticResource BorderBrush}" Height="1"/>

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="Reset all settings"
                           FontSize="13"/>
                <TextBlock Text="Clear saved connection and preferences to defaults"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
              </StackPanel>
              <Button Grid.Column="1"
                      Command="{Binding ResetSettingsCommand}"
                      Padding="12,6"
                      VerticalAlignment="Center">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                  <Image Source="avares://XBVault/Assets/Views/SettingsView/settings-reset-20.png"
                         Width="20" Height="20"
                         Stretch="Uniform"/>
                  <TextBlock Grid.Column="1" Text="Reset"
                             FontSize="12"
                             VerticalAlignment="Center"/>
                </Grid>
              </Button>
            </Grid>

            <Separator Background="{StaticResource BorderBrush}" Height="1"/>

            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="4">
                <TextBlock Text="Open settings folder"
                           FontSize="13"/>
                <TextBlock Text="View or edit the settings file directly"
                           FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}"/>
              </StackPanel>
              <Button Grid.Column="1"
                      Command="{Binding OpenSettingsFolderCommand}"
                      Padding="12,6"
                      VerticalAlignment="Center">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                  <Image Source="avares://XBVault/Assets/Views/SettingsView/settings-folder-20.png"
                         Width="20" Height="20"
                         Stretch="Uniform"/>
                  <TextBlock Grid.Column="1" Text="Open"
                             FontSize="12"
                             VerticalAlignment="Center"/>
                </Grid>
              </Button>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Version -->
        <TextBlock x:Name="VersionText"
                   Grid.Row="1"
                   Grid.ColumnSpan="2"
                   FontSize="11"
                   Foreground="{StaticResource TextDimBrush}"
                   HorizontalAlignment="Center"
                   Margin="0,8,0,24"/>

      </Grid>
    </ScrollViewer>

  </Grid>

</UserControl>
