<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XBVault.ViewModels"
             xmlns:models="using:XBVault.Models"
             xmlns:converters="using:XBVault.Converters"
             xmlns:svc="using:XBVault.Services"
             x:Class="XBVault.Views.LogsView"
             x:DataType="vm:LogsViewModel">

  <UserControl.Resources>
    <converters:LogLevelToBrushConverter x:Key="LevelToBrush"/>
    <converters:LogLevelToIconConverter x:Key="LevelToIcon"/>
    <converters:BoolToHighlightBgConverter x:Key="BoolToHighlightBg"/>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,*" Margin="32,22,32,32" RowSpacing="12">
    <StackPanel Grid.Row="0">
      <TextBlock Text="LOGS" Classes="PageTitle"/>
      <TextBlock Text="View application log output"
                 Classes="Muted" FontSize="14" Margin="0,4,0,0"/>
    </StackPanel>
    <Border Grid.Row="1" Padding="8,6" CornerRadius="6" Background="{StaticResource SurfaceAltBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <CheckBox IsChecked="{Binding AutoScroll}"
                    FontSize="13" Foreground="White"/>
          <TextBlock Text="Auto-scroll"
                     FontSize="13" Foreground="White"
                     VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock Grid.Column="1"/>
        <Button Grid.Column="2"
                Command="{Binding DecreaseLogFontSizeCommand}"
                Padding="8,4"
                ToolTip.Tip="Decrease log font size">
          <Image Source="avares://XBVault/Assets/Views/LogsView/logs-font-decrease-16.png"
                 Width="16" Height="16" Stretch="Uniform"/>
        </Button>
        <Button Grid.Column="3"
                Command="{Binding IncreaseLogFontSizeCommand}"
                Padding="8,4"
                ToolTip.Tip="Increase log font size">
          <Image Source="avares://XBVault/Assets/Views/LogsView/logs-font-increase-16.png"
                 Width="16" Height="16" Stretch="Uniform"/>
        </Button>
        <Button Grid.Column="4" x:Name="CopyButton"
                Click="OnCopyClick"
                Padding="8,4"
                ToolTip.Tip="Copy all log entries">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
            <Image Source="avares://XBVault/Assets/Views/ErrorDialog/errordialog-copy-20.png"
                   Width="16" Height="16" Stretch="Uniform"/>
            <TextBlock Grid.Column="1" x:Name="CopyButtonText"
                       Text="Copy All" FontSize="12" VerticalAlignment="Center"/>
          </Grid>
        </Button>
        <Button Grid.Column="5" x:Name="ClearButton"
                Click="OnClearClick"
                Padding="8,4"
                ToolTip.Tip="Clear all log entries">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
            <Image Source="avares://XBVault/Assets/Views/SettingsView/settings-clear-20.png"
                   Width="16" Height="16" Stretch="Uniform"/>
            <TextBlock Grid.Column="1" Text="Clear" FontSize="12" VerticalAlignment="Center"/>
          </Grid>
        </Button>
        <Button Grid.Column="6"
                Command="{Binding ToggleFilterCommand}"
                Padding="8,4"
                ToolTip.Tip="Toggle filter panel">
          <Image Source="avares://XBVault/Assets/Views/LogsView/logs-filter-20.png"
                 Width="16" Height="16" Stretch="Uniform"/>
        </Button>
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="12">
        <Grid>
          <ScrollViewer Name="LogScrollViewer">
            <ListBox Name="LogListBox"
                     ItemsSource="{Binding FilteredLogs}"
                     SelectionMode="Multiple"
                     BorderThickness="0"
                     Background="Transparent">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="0"/>
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:FilteredLogEntry">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6"
                        Background="{Binding IsMatch, Converter={StaticResource BoolToHighlightBg}}">
                    <Image Source="{Binding Entry.Level, Converter={StaticResource LevelToIcon}}"
                           Width="16" Height="16"
                           Stretch="Uniform"
                           VerticalAlignment="Center"/>
                    <SelectableTextBlock Grid.Column="1"
                                          Text="{Binding Entry.Message}"
                                          FontFamily="{StaticResource MonoFont}"
                                          FontSize="{Binding $parent[UserControl].DataContext.LogFontSize}"
                                          TextWrapping="NoWrap"
                                          VerticalAlignment="Center"
                                         Foreground="{Binding Entry.Level, Converter={StaticResource LevelToBrush}}"/>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Filter overlay — sibling of Border, flush to top-right -->
      <Border IsVisible="{Binding IsFilterVisible}"
              HorizontalAlignment="Right" VerticalAlignment="Top"
              Background="{StaticResource SurfaceBrush}"
              BorderThickness="0"
              CornerRadius="0,0,0,6"
              Padding="10,8"
              Margin="0"
              MinWidth="200">
        <StackPanel Spacing="5">
            <TextBox Text="{Binding FilterText}"
                     PlaceholderText="Filter..."
                     FontSize="13"
                     Background="{StaticResource SurfaceAltBrush}"
                     KeyDown="OnFilterKeyDown"/>
             <TextBlock Text="{Binding FilterMatchText}"
                        FontSize="11"
                        Foreground="{StaticResource WarningBrush}"/>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
            <TextBlock Text="Above Lines" FontSize="12" VerticalAlignment="Center"
                       Foreground="{StaticResource TextMutedBrush}"/>
            <Grid Grid.Column="1" HorizontalAlignment="Right"
                  ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="0">
              <Button Grid.Column="0"
                      Command="{Binding DecrementFilterLinesAboveCommand}"
                      Background="Transparent" BorderThickness="0"
                      Padding="0" Width="12" Height="14"
                      Margin="0,0,2,0">
                <Image Source="avares://XBVault/Assets/Views/LogsView/logs-filter-dec-10.png"
                       Width="10" Height="10" Stretch="Uniform"/>
              </Button>
              <TextBlock Grid.Column="1"
                         Text="{Binding FilterLinesAbove}"
                         FontSize="13" FontFamily="{StaticResource MonoFont}"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         MinWidth="8"
                         Foreground="{StaticResource TextMutedBrush}"/>
              <Button Grid.Column="2"
                      Command="{Binding IncrementFilterLinesAboveCommand}"
                      Background="Transparent" BorderThickness="0"
                      Padding="0" Width="12" Height="14">
                <Image Source="avares://XBVault/Assets/Views/LogsView/logs-filter-inc-10.png"
                       Width="10" Height="10" Stretch="Uniform"/>
              </Button>
            </Grid>
          </Grid>
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
            <TextBlock Text="Below Lines" FontSize="12" VerticalAlignment="Center"
                       Foreground="{StaticResource TextMutedBrush}"/>
            <Grid Grid.Column="1" HorizontalAlignment="Right"
                  ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="0">
              <Button Grid.Column="0"
                      Command="{Binding DecrementFilterLinesBelowCommand}"
                      Background="Transparent" BorderThickness="0"
                      Padding="0" Width="12" Height="14"
                      Margin="0,0,2,0">
                <Image Source="avares://XBVault/Assets/Views/LogsView/logs-filter-dec-10.png"
                       Width="10" Height="10" Stretch="Uniform"/>
              </Button>
              <TextBlock Grid.Column="1"
                         Text="{Binding FilterLinesBelow}"
                         FontSize="13" FontFamily="{StaticResource MonoFont}"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         MinWidth="8"
                         Foreground="{StaticResource TextMutedBrush}"/>
              <Button Grid.Column="2"
                      Command="{Binding IncrementFilterLinesBelowCommand}"
                      Background="Transparent" BorderThickness="0"
                      Padding="0" Width="12" Height="14">
                <Image Source="avares://XBVault/Assets/Views/LogsView/logs-filter-inc-10.png"
                       Width="10" Height="10" Stretch="Uniform"/>
              </Button>
            </Grid>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>

</UserControl>
