<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:XBVault.ViewModels"
             xmlns:models="using:XBVault.Models"
             xmlns:controls="using:XBVault.Controls"
             x:Class="XBVault.Views.MobileBrowseView"
             x:DataType="vm:BrowseViewModel"
             Background="{StaticResource BgBrush}">

  <UserControl.Styles>
    <Style Selector="Border.CatalogCard">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ClipToBounds" Value="True"/>
      <Setter Property="Margin" Value="16,0,16,0"/>
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Margin" Value="0,7,0,7"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*">

    <!-- Header -->
    <StackPanel Grid.Row="0" Margin="16,12,16,8">
      <TextBlock Text="BROWSE"
                 FontFamily="{StaticResource TitleFont}"
                 FontSize="18" FontWeight="Bold"
                 Foreground="{StaticResource TextBrush}"/>
      <TextBlock Text="Discover homebrew apps and emulators"
                 FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                 Margin="0,2,0,0"/>
    </StackPanel>

    <!-- Search bar + Sideload -->
    <Border Grid.Row="1"
            Background="{StaticResource SurfaceBrush}"
            Padding="16,8"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Grid.Column="0"
                 x:Name="SearchBox"
                 PlaceholderText="Search catalog..."
                 Text="{Binding SearchText}"
                 FontSize="15" Padding="12,10"/>
        <Button Grid.Column="1"
                Command="{Binding OpenCustomInstallCommand}"
                Padding="14,10"
                ToolTip.Tip="Install a custom package from file">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Image Source="avares://XBVault/Assets/Views/ToolsView/tools-install-20.png"
                   Width="20" Height="20" Stretch="Uniform"/>
            <TextBlock Grid.Column="1" Text="Sideload" FontSize="14" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
          </Grid>
        </Button>
      </Grid>
    </Border>

    <!-- Category filter -->
    <ComboBox Grid.Row="2"
              ItemsSource="{Binding Categories}"
              SelectedItem="{Binding SelectedCategory}"
              Margin="16,8,16,8"
              HorizontalAlignment="Stretch"
              FontSize="14" Padding="12,8"/>

    <!-- Loading overlay -->
    <Border Grid.Row="3" IsVisible="{Binding IsLoading}"
            Background="{StaticResource BgBrush}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <controls:CdSpinner/>
        <ProgressBar IsIndeterminate="True" Width="200"
                     Foreground="{StaticResource AccentBrush}"/>
        <TextBlock Text="Loading catalog..."
                   Foreground="{StaticResource TextMutedBrush}"
                   FontSize="13" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Empty state -->
    <Border Grid.Row="3" IsVisible="{Binding ShowNoItems}"
            IsHitTestVisible="False"
            Background="{StaticResource BgBrush}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <TextBlock Text="No items found"
                   FontSize="16" Foreground="{StaticResource TextMutedBrush}"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="Adjust your search or filters"
                   FontSize="13" Foreground="{StaticResource TextDimBrush}"
                   HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- Catalog list -->
    <ListBox Grid.Row="3"
             x:Name="BrowseListBox"
             ItemsSource="{Binding Items}"
             IsVisible="{Binding HasItems}"
             Background="Transparent"
             BorderThickness="0"
             Padding="0"
             Margin="0"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             SelectionMode="Single"
             SelectionChanged="OnSelectionChanged">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="models:CatalogItem">
          <Border Classes="CatalogCard">
              <Grid RowDefinitions="180,Auto">
                <!-- Row 0: Image with badge overlay -->
                <Grid Grid.Row="0" ClipToBounds="True">
                  <Border Background="{StaticResource SurfaceAltBrush}">
                    <Panel>
                      <Image Source="{Binding Thumbnail}"
                             Stretch="UniformToFill"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                             RenderOptions.BitmapInterpolationMode="MediumQuality"
                             IsVisible="{Binding IsThumbnailLoading, Converter={StaticResource BoolInverse}}"/>
                      <Border Background="{StaticResource SurfaceAltBrush}"
                              IsVisible="{Binding IsThumbnailLoading}">
                        <controls:CdSpinner/>
                      </Border>
                    </Panel>
                  </Border>
                  <!-- Badge overlay: top-right of image -->
                  <Border CornerRadius="6" Padding="10,4"
                          HorizontalAlignment="Right" VerticalAlignment="Top"
                          Margin="0,10,12,0"
                          Background="{Binding BadgeBrush}"
                          IsVisible="{Binding ShowBadge}">
                    <TextBlock Text="{Binding BadgeText}"
                               FontSize="10" FontWeight="Bold" Foreground="White"/>
                  </Border>
                </Grid>

                <!-- Row 1: Text content -->
                <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" Padding="14,12,14,14">
                  <StackPanel Spacing="5">
                    <TextBlock Text="{Binding Name}"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="White"
                               TextWrapping="Wrap" MaxLines="2"/>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                      <TextBlock Grid.Column="0" Text="{Binding Category}"
                                 FontSize="12" FontWeight="SemiBold"
                                 Foreground="{StaticResource AccentBrush}"/>
                      <TextBlock Grid.Column="2"
                                 Text="{Binding Version}"
                                 FontSize="12" Foreground="#888"/>
                    </Grid>
                    <TextBlock Text="{Binding Description}"
                               FontSize="13" Foreground="#999"
                               TextWrapping="Wrap" MaxLines="2"
                               Margin="0,2,0,0"/>
                  </StackPanel>
                </Border>
              </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>



  </Grid>

</UserControl>
