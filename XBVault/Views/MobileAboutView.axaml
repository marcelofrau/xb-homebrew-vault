<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="XBVault.Views.MobileAboutView"
             Background="{StaticResource BgBrush}">

  <UserControl.Styles>
    <Style Selector="Button.ActionBtn">
      <Setter Property="Background" Value="#4E56D0"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    </Style>
    <Style Selector="Button.ActionBtn:pointerover">
      <Setter Property="Background" Value="#5B63E0"/>
    </Style>

    <Style Selector="Button.LinkBtn">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Header -->
    <Grid Grid.Row="0" Background="{StaticResource SurfaceBrush}">
      <Grid.ColumnDefinitions>
        <Button Width="44" Height="44" Classes="TabBtn" Click="OnBackClick" HorizontalAlignment="Left">
          <TextBlock Text="←" FontSize="20" FontWeight="Bold"
                     Foreground="{StaticResource TextBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
      </Grid.ColumnDefinitions>
      <TextBlock Text="About"
                 FontFamily="{StaticResource TitleFont}"
                 FontSize="17" FontWeight="Bold"
                 Foreground="{StaticResource TextBrush}"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>
    </Grid>

    <!-- Content -->
    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="0" HorizontalAlignment="Center" Margin="24,20">

        <!-- App Icon -->
        <Image Source="avares://XBVault/Assets/Views/AboutWindow/about-appicon-80.png"
               Width="80" Height="80"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               Margin="0,0,0,8"/>

        <!-- Title -->
        <TextBlock Text="XB HOMEBREW"
                   FontSize="14" FontWeight="Bold"
                   Foreground="{StaticResource AccentBrush}"
                   HorizontalAlignment="Center"
                   LetterSpacing="2"/>
        <TextBlock Text="VAULT"
                   FontSize="30" FontWeight="Bold"
                   Foreground="{StaticResource TextBrush}"
                   HorizontalAlignment="Center"
                   LetterSpacing="3"
                   Margin="0,-4,0,0"/>

        <TextBlock Text="Companion for Xbox Dev Mode"
                   FontSize="12"
                   Foreground="#B0B0B0"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0"/>

        <Separator Width="40" Height="2"
                   Background="{StaticResource AccentBrush}"
                   Margin="0,8"
                   HorizontalAlignment="Center"/>

        <!-- Version + Changelog -->
        <StackPanel Spacing="4" Margin="0,4,0,0" HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
            <TextBlock x:Name="VersionText"
                       FontSize="15" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"
                       VerticalAlignment="Center"/>
            <Button Cursor="Hand"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="3"
                    VerticalAlignment="Center"
                    Click="OnChangelogClick">
              <Image Source="avares://XBVault/Assets/Views/AboutWindow/about-changelog-20.png"
                     Width="14" Height="14"
                     Stretch="Uniform"/>
            </Button>
          </StackPanel>
          <TextBlock Text="Marcelo Frau" FontSize="11" Foreground="#888" HorizontalAlignment="Center"/>
          <TextBlock Text="GPL-3.0-only" FontSize="12" FontWeight="SemiBold"
                     Foreground="{StaticResource YellowBrush}" HorizontalAlignment="Center"/>
        </StackPanel>

        <Separator Width="120" Height="1" Background="#555" Margin="0,12" HorizontalAlignment="Center"/>

        <!-- Discord -->
        <TextBlock Text="Community" FontSize="12" FontWeight="Bold"
                   Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
        <Button Classes="ActionBtn" Click="OnDiscordClick">
          <Button.Flyout>
            <Flyout Placement="Bottom">
              <StackPanel Width="240" Spacing="4" Margin="8" Background="{StaticResource SurfaceAltBrush}">
                <TextBlock Text="Choose a server to join:"
                           FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                           Margin="4,4,4,0"/>
                <Button Classes="ActionBtn" Click="OnDiscordRevives">
                  <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                    <Image Source="avares://XBVault/Assets/Views/DiscordPopup/discordpopup-discord-48.png"
                           Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="REVIVES COMMUNITY" FontSize="11" VerticalAlignment="Center"/>
                  </Grid>
                </Button>
                <Button Classes="ActionBtn" Click="OnDiscordXboxHub">
                  <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                    <Image Source="avares://XBVault/Assets/Views/DiscordPopup/discordpopup-discord-48.png"
                           Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="XBOX EMULATION HUB" FontSize="11" VerticalAlignment="Center"/>
                  </Grid>
                </Button>
                <Button Classes="ActionBtn" Click="OnDiscordEr">
                  <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                    <Image Source="avares://XBVault/Assets/Views/DiscordPopup/discordpopup-discord-48.png"
                           Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="EMULATION REVIVAL" FontSize="11" VerticalAlignment="Center"/>
                  </Grid>
                </Button>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
          <Grid ColumnDefinitions="20,*" ColumnSpacing="8" HorizontalAlignment="Center">
            <Image Source="avares://XBVault/Assets/Views/DiscordPopup/discordpopup-discord-48.png"
                   Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="JOIN DISCORD" VerticalAlignment="Center"/>
          </Grid>
        </Button>

        <Separator Width="120" Height="1" Background="#555" Margin="0,12" HorizontalAlignment="Center"/>

        <!-- Links -->
        <Button Classes="LinkBtn" Click="OnErLinkClick" HorizontalAlignment="Center">
          <StackPanel Spacing="4">
            <Image Source="avares://XBVault/Assets/Views/AboutWindow/about-erlogo.png"
                   Width="140" Height="40"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"/>
            <TextBlock Text="Catalog powered by Emulation Revival"
                       FontSize="11" Foreground="#777"
                       HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>

        <Button Classes="LinkBtn" Click="OnProjectLinkClick" HorizontalAlignment="Center" Margin="0,4,0,0">
          <TextBlock Text="github.com/marcelofrau/xb-homebrew-vault"
                     FontSize="11" Foreground="#999"/>
        </Button>

      </StackPanel>
    </ScrollViewer>
  </Grid>

</UserControl>
